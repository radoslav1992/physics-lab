---
import '../styles/global.css';
import '../styles/studio.css';
import '../styles/physics.css';
const {title='Free Physics Visualizer & Interactive Simulations',description='Explore physics with free interactive simulations, visual calculators, worked explanations, and practice. Discover motion, forces, waves, circuits, and optics.',section='Explore'}=Astro.props;
const url=new URL(Astro.url.pathname,Astro.site);
const nav=[['Explore','/'],['Experiments','/experiments/'],['Learn','/learn/'],['Practice','/practice/'],['Formulas','/formulas/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Physics Lab</title><meta name="description" content={description}/><link rel="canonical" href={url}/><meta name="theme-color" content="#fffaf1"/><meta property="og:title" content={`${title} | Physics Lab`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={url}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:'Physics Lab',url:url.href,description,applicationCategory:'EducationalApplication',operatingSystem:'Any',isAccessibleForFree:true})}/></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a href="/" class="brand" aria-label="Physics Lab home"><img src="/favicon.svg" alt="" width="44" height="44"/><span>physics<span class="brand-light">lab</span><small>A LITTLE WONDER. A LOT OF WHY.</small></span></a><nav aria-label="Main navigation">{nav.map(([label,href])=><a href={href} class:list={{active:label===section}} aria-current={label===section?'page':undefined}>{label}</a>)}</nav><a href="/worksheets/" class="header-learn">Worksheets ↗</a></header><main id="main"><slot/></main><footer class="site-footer"><a class="footer-brand" href="/">physics<span class="brand-light">lab</span></a><p>Big ideas. Small experiments.</p><div><a href="/units/">Units & constants</a><a href="/about/">About the lab</a><a href="/worksheets/">Print & practice</a></div><span>Free to explore. No account needed. Educational models with their assumptions explained.</span></footer></body></html>
