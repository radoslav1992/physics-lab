---
import LearningApps from '../components/LearningApps.astro';
import Layout from '../layouts/Layout.astro';import Experiment from '../components/Experiment.astro';import Cards from '../components/Cards.astro';import Faq from '../components/Faq.astro';import {experiments} from '../lib/experiments.mjs';
const questions=[{question:'What can I explore in Physics Lab?',answer:'Twelve interactive experiments cover projectile motion, motion graphs, forces, energy, oscillations, waves, electrical circuits, buoyancy, refraction, and lenses. Change an input to see the diagram, measurements, and worked calculation respond.',href:'/experiments/',label:'Find an experiment'},{question:'Is Physics Lab free?',answer:'Yes. Experiments, lessons, quizzes, worksheets, and diagram downloads are free without an account. All calculations happen in your browser.'},{question:'Are the simulations physically realistic?',answer:'They use standard introductory physics models. Every experiment explains its assumptions, such as no air resistance, no friction, a small-angle approximation, or ideal circuit components. Use them to understand relationships rather than as engineering design tools.'},{question:'Can I use this in a lesson?',answer:'Yes. Share a link containing your experiment settings, download an SVG diagram, or print a worksheet with an optional answer key. The practice studio also gives an explanation after every answer.',href:'/worksheets/',label:'Create a worksheet'},{question:'Where should I begin?',answer:'Try changing the launch angle in the projectile experiment. Predict which angle sends the ball farthest, then test it. Follow the linked lesson when you want to understand why.',href:'/experiments/projectile-motion/',label:'Explore projectile motion'}];
---
<Layout><section class="home-stage"><div class="home-intro"><div class="eyebrow">A playground for curious minds</div><h1>Interactive <em>Physics</em><br/>Visualizer.</h1><p><strong class="playful-lead">A little wonder. A big “why?”</strong>Launch a ball. Bend a ray. Catch a wave. Make the invisible click.</p><a href="/experiments/" class="primary-link">Find your next experiment ↗</a><div class="home-note"><span class="note-mark" aria-hidden="true">↳</span><span>Start right here.<br/><strong>Which angle goes the farthest?</strong></span></div><span class="free-note">Free tools · No account · Just curiosity</span></div><div class="home-experiment"><Experiment tool={experiments[0]} compact/><a href="/experiments/projectile-motion/" class="experiment-link">Open the full projectile lab <span>↗</span></a></div></section><div class="stat-strip"><span><strong>12</strong>interactive experiments</span><span><strong>5</strong>fields of physics</span><span><strong>12</strong>concept lessons</span><span><strong>100</strong>practice questions</span></div><div class="section-heading"><div><div class="eyebrow">Follow a question</div><h2>Physics Simulations & Visual Calculators</h2><p>What happens if…? There’s only one way to find out.</p></div><a class="text-link" href="/experiments/">Explore all experiments ↗</a></div><Cards tools={[experiments[1],experiments[3],experiments[4],experiments[6],experiments[8],experiments[9]]}/><div class="learning-strip"><div><span class="strip-label">PREDICT. PLAY. UNDERSTAND.</span><h2>Make your next “aha” stick.</h2><p>Eight questions. Clear explanations. All the time you need.</p></div><a href="/practice/">Try a practice round ↗</a></div><LearningApps/><Faq items={questions} title="Physics Lab: frequently asked questions"/></Layout>
