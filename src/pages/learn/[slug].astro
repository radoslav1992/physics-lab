---
import RelatedLearning from '../../components/RelatedLearning.astro';
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import {experiments,defaults} from '../../lib/experiments.mjs';import {calculate} from '../../lib/physics.mjs';import {diagram} from '../../lib/diagrams.mjs';
export function getStaticPaths(){return experiments.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;const result=calculate(tool.slug,defaults(tool),.25,tool.modes?.[0][0]??'series');
---
<Layout title={`${tool.title}: Formulas & Worked Examples`} description={tool.lesson} section="Learn"><article class="article"><div class="breadcrumb"><a href="/learn/">Field notes</a> / {tool.category}</div><div class="eyebrow">{tool.tag}</div><h1>{tool.title}, explained.</h1><p class="lesson-lead">{tool.lesson}</p><div class="lesson-diagram"><svg viewBox="0 0 680 360" role="img" aria-label={`${tool.title} example diagram`} set:html={diagram(tool.slug,result.model)}/></div><h2>The relationship to remember</h2><div class="formula">{tool.formula}</div><h2>A worked example</h2><p>{tool.example}</p><h3>Inside the default experiment</h3><ol>{result.steps.map(s=><li>{s}</li>)}</ol><h2>When this model applies</h2><p>{tool.assumption}</p><aside class="challenge"><span class="badge">A COMMON MIX-UP</span><p>{tool.pitfall}</p></aside><h2>Make a prediction. Then test it.</h2><p>{tool.challenge}</p><a class="primary-link" href={`/experiments/${tool.slug}/`}>Try the interactive experiment ↗</a><Faq items={tool.faqs.map(([question,answer])=>({question,answer}))}/><div class="related"><a href="/formulas/">All physics formulas ↗</a><a href="/practice/">Test your understanding ↗</a></div><RelatedLearning topic={tool.slug}/></article></Layout>
