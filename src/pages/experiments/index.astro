---
import Layout from '../../layouts/Layout.astro';import Cards from '../../components/Cards.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import {experiments,categories} from '../../lib/experiments.mjs';import {guideFor} from '../../lib/guides.mjs';
// Plain list of every simulation for search engines: name, address and position, matching the visible table below.
const itemList={'@context':'https://schema.org','@type':'ItemList',name:'Physics simulations',numberOfItems:experiments.length,itemListElement:experiments.map((t,i)=>({'@type':'ListItem',position:i+1,name:guideFor(t.slug).heading,url:new URL(`/experiments/${t.slug}/`,Astro.site).href}))};
---
<Layout title="Physics Simulations: 12 Free Interactive Online Experiments" description="Physics simulations to run free in your browser: 12 interactive experiments on motion, forces, energy, waves, circuits and optics, with worked formulas." section="Experiments" schemaType="CollectionPage"><Breadcrumbs items={[['Home','/'],['Experiments']]}/><div class="intro"><div><div class="eyebrow">One question. Twelve ways in.</div><h1>Physics simulations: 12 free interactive experiments</h1><p>Twelve free physics simulations for motion, forces, energy, waves, circuits, and light. Each one is an online experiment: change a value, watch the diagram and measurements respond, and see the formula and worked steps behind every result.</p></div></div><experiment-catalog><div class="catalog-controls"><input data-search type="search" placeholder="Search motion, voltage, lenses…" aria-label="Search experiments"/><div class="pills">{categories.map((c,i)=><button data-category={c} class:list={['pill',{selected:i===0}]} aria-pressed={i===0}>{c}</button>)}</div></div><p class="catalog-count" data-count aria-live="polite">12 experiments</p><Cards tools={experiments} adAfter={3}/><p class="catalog-empty" data-empty hidden>No experiments match. Try another word or choose All.</p></experiment-catalog><div class="section-heading"><div><h2 id="all-simulations">What each physics simulation does</h2><p>All twelve simulations, with what you can change and what you can measure in each.</p></div></div><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th scope="col">Simulation</th><th scope="col">What you can change and measure</th><th scope="col">Topic</th></tr></thead><tbody>{experiments.map(t=><tr><td><a class="text-link" href={`/experiments/${t.slug}/`}>{guideFor(t.slug).heading}</a></td><td>{guideFor(t.slug).summary}</td><td>{t.category}</td></tr>)}</tbody></table></div><script type="application/ld+json" set:html={JSON.stringify(itemList)}/><div class="related"><a href="/learn/">Lessons with worked examples ↗</a><a href="/formulas/">Physics formula sheet ↗</a><a href="/practice/">Physics practice problems ↗</a><a href="/worksheets/">Printable worksheets ↗</a></div></Layout>
<script>
class Catalog extends HTMLElement{connectedCallback(){let category='All';const input=this.querySelector('[data-search]') as HTMLInputElement;const cards=Array.from(this.querySelectorAll<HTMLElement>('[data-tool]'));const update=()=>{let n=0;cards.forEach(c=>{c.hidden=!(c.dataset.text!.includes(input.value.trim().toLowerCase())&&(category==='All'||c.dataset.topic===category));if(!c.hidden)n++});this.querySelector('[data-count]')!.textContent=`${n} ${n===1?'experiment':'experiments'}`;const ad=this.querySelector<HTMLElement>('[data-grid-ad]');if(ad)ad.hidden=category!=='All'||input.value.trim()!=='';(this.querySelector('[data-empty]') as HTMLElement).hidden=n!==0;};input.oninput=update;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.onclick=()=>{category=b.dataset.category!;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});update();});}}
customElements.define('experiment-catalog',Catalog);
</script>
