---
import Layout from '../layouts/Layout.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import FormulaList from '../components/FormulaList.astro';import AdSlot from '../components/AdSlot.astro';import {experiments,categories} from '../lib/experiments.mjs';import {guideFor} from '../lib/guides.mjs';
const groups=categories.slice(1).map(name=>({name,id:name.toLowerCase().replace(/[^a-z]+/g,'-'),tools:experiments.filter(t=>t.category===name)}));
const essentials=[['Newton’s second law','F = ma','Net force (N) = mass (kg) × acceleration (m/s²)'],['Weight','W = mg','g = 9.81 m/s² near Earth’s surface'],['Momentum','p = mv','Measured in kg·m/s'],['Impulse','FΔt = Δp','Force × time equals the change in momentum (N·s)'],['Work done by a force','W = Fd cos θ','θ is the angle between the force and the displacement'],['Power','P = W/t = Fv','Rate of doing work, in watts (W = J/s)'],['Centripetal acceleration','a = v²/r','Points toward the centre of the circle'],['Centripetal force','F = mv²/r','r is the radius of the circular path'],['Newton’s law of gravitation','F = Gm₁m₂/r²','G = 6.674 × 10⁻¹¹ N·m²/kg²; r is the distance between centres'],['Density','ρ = m/V','Measured in kg/m³'],['Pressure','p = F/A','Measured in pascals (Pa = N/m²)'],['Fluid pressure at depth','p = ρgh','h is the depth below the surface'],['Electric charge','Q = It','Charge (C) = current (A) × time (s)'],['Efficiency','η = useful output ÷ total input × 100%','Works for energy or power']];
---
<Layout title="Physics Formula Sheet: Motion, Forces, Energy, Waves & Circuits" description="Free physics formula sheet: kinematics, projectile motion, friction, energy, pendulums, springs, waves, Ohm’s law, circuits and optics, with units and notes." section="Formulas" schemaType="Article"><Breadcrumbs items={[['Home','/'],['Formula sheet']]}/><div class="intro"><div><div class="eyebrow">Keep the useful ideas close</div><h1>Physics formula sheet</h1><p>Every formula used in The Physics Lab in one place: kinematics, projectile motion, forces, energy, oscillations, waves, electricity, and optics. Each entry says what the formula finds and when it applies, and every group links to a simulation that shows it working.</p></div></div><nav class="related" aria-label="Formula topics">{groups.map(g=><a href={`#${g.id}`}>{g.name} formulas</a>)}<a href="#more-formulas">More essential formulas</a></nav><div class="formula-groups">{groups.map((g,i)=><><section id={g.id}><h2>{g.name} formulas</h2><div class="formula-reference">{g.tools.map(t=><section class="explanation"><span class="badge">{t.category}</span><h3>{t.title}</h3><FormulaList formulas={guideFor(t.slug).formulas}/><p>{t.assumption}</p><div class="formula-card-links"><a class="text-link" href={`/experiments/${t.slug}/`}>{guideFor(t.slug).heading} ↗</a><a class="text-link" href={`/learn/${t.slug}/`}>Worked example ↗</a></div></section>)}</div></section>{i===0&&<AdSlot type="rectangle"/>}</>)}<section id="more-formulas"><h2>More essential physics formulas</h2><p class="small-note">Standard relationships that appear alongside the simulations in most introductory courses.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th>Quantity</th><th>Formula</th><th>What the symbols mean</th></tr></thead><tbody>{essentials.map(([name,formula,note])=><tr><td>{name}</td><td><code>{formula}</code></td><td>{note}</td></tr>)}</tbody></table></div></section></div><div class="related"><a href="/physics-symbols/">Physics symbols explained ↗</a><a href="/units/">Units & constants ↗</a><a href="/worksheets/">Print a practice sheet ↗</a></div></Layout>
