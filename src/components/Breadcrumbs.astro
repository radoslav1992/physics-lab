---
// Visible breadcrumb trail plus matching BreadcrumbList structured data. The last item is the current page.
interface Props { items: [string, string?][] }
const {items}=Astro.props;
const list={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:items.map(([name,href],i)=>({'@type':'ListItem',position:i+1,name,item:new URL(href??Astro.url.pathname,Astro.site).href}))};
---
<nav class="breadcrumb" aria-label="Breadcrumb">{items.map(([name,href],i)=><>{i>0&&<span aria-hidden="true"> / </span>}{href?<a href={href}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav><script type="application/ld+json" set:html={JSON.stringify(list)}/>
