---
import Layout from '../../layouts/Layout.astro';import Cards from '../../components/Cards.astro';import {experiments,categories} from '../../lib/experiments.mjs';
---
<Layout title="Interactive Physics Experiments & Calculators" section="Experiments"><div class="intro"><div><div class="eyebrow">Your next discovery starts here</div><h1>One question. Twelve ways in.</h1><p>Explore motion, energy, waves, circuits, and light. Change something. Notice what follows.</p></div></div><experiment-catalog><div class="catalog-controls"><input data-search type="search" placeholder="Search motion, voltage, lenses…" aria-label="Search experiments"/><div class="pills">{categories.map((c,i)=><button data-category={c} class:list={['pill',{selected:i===0}]} aria-pressed={i===0}>{c}</button>)}</div></div><p class="catalog-count" data-count aria-live="polite">12 experiments</p><Cards tools={experiments}/><p class="catalog-empty" data-empty hidden>No experiments match. Try another word or choose All.</p></experiment-catalog></Layout>
<script>
class Catalog extends HTMLElement{connectedCallback(){let category='All';const input=this.querySelector('[data-search]') as HTMLInputElement;const cards=Array.from(this.querySelectorAll<HTMLElement>('[data-tool]'));const update=()=>{let n=0;cards.forEach(c=>{c.hidden=!(c.dataset.text!.includes(input.value.trim().toLowerCase())&&(category==='All'||c.dataset.topic===category));if(!c.hidden)n++});this.querySelector('[data-count]')!.textContent=`${n} ${n===1?'experiment':'experiments'}`;(this.querySelector('[data-empty]') as HTMLElement).hidden=n!==0;};input.oninput=update;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.onclick=()=>{category=b.dataset.category!;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});update();});}}
customElements.define('experiment-catalog',Catalog);
</script>
