---
import Layout from '../layouts/Layout.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import FormulaList from '../components/FormulaList.astro';import AdSlot from '../components/AdSlot.astro';import {experiments,categories} from '../lib/experiments.mjs';import {guideFor} from '../lib/guides.mjs';
const groups=categories.slice(1).map(name=>({name,id:name.toLowerCase().replace(/[^a-z]+/g,'-'),tools:experiments.filter(t=>t.category===name)}));
// Each row: name, formula, note, the id of its link anchor (/formulas/#centripetal-force), and optionally the simulation that uses it.
const essentials=[['Newton’s second law','F = ma','Net force (N) = mass (kg) × acceleration (m/s²)','newtons-second-law'],['Weight','W = mg','g = 9.81 m/s² near Earth’s surface','weight'],['Momentum','p = mv','Measured in kg·m/s','momentum','collisions'],['Impulse','FΔt = Δp','Force × time equals the change in momentum (N·s)','impulse','collisions'],['Work done by a force','W = Fd cos θ','θ is the angle between the force and the displacement','work'],['Power','P = W/t = Fv','Rate of doing work, in watts (W = J/s)','power'],['Centripetal acceleration','a = v²/r','Points toward the centre of the circle','centripetal-acceleration','circular-motion'],['Centripetal force','F = mv²/r','r is the radius of the circular path','centripetal-force','circular-motion'],['Gravitational force of attraction (Newton’s law of gravitation)','F = Gm₁m₂/r²','G = 6.674 × 10⁻¹¹ N·m²/kg²; r is the distance between centres','gravitational-force','circular-motion'],['Density','ρ = m/V','Measured in kg/m³','density'],['Pressure','p = F/A','Measured in pascals (Pa = N/m²)','pressure'],['Fluid pressure at depth','p = ρgh','h is the depth below the surface','fluid-pressure'],['Electric charge','Q = It','Charge (C) = current (A) × time (s)','electric-charge'],['Efficiency','η = useful output ÷ total input × 100%','Works for energy or power','efficiency']];
---
<Layout title="Physics Formulas Sheet: Motion, Forces, Energy & Circuits" description="Physics formulas sheet by topic: projectile motion, friction (f = μmg), energy, buoyancy, waves, Ohm’s law, series and parallel resistors, and lenses." section="Formulas" schemaType="Article"><Breadcrumbs items={[['Home','/'],['Formula sheet']]}/><div class="intro"><div><div class="eyebrow">Keep the useful ideas close</div><h1>Physics formulas sheet: equations by topic</h1><p>Every formula used in The Physics Lab in one place: kinematics, free fall, projectile motion, friction, circular motion, momentum and collisions, energy, buoyancy, oscillations, waves, electricity, and optics. Each entry says what the formula finds and when it applies, and every topic links to a simulation that shows it working and a lesson with a worked example.</p></div></div><nav class="related" aria-label="Formula topics">{groups.map(g=><a href={`#${g.id}`}>{g.name} formulas</a>)}<a href="#more-formulas">More essential formulas</a></nav><div class="formula-groups">{groups.map((g,i)=><><section id={g.id}><h2>{g.name} formulas</h2><p class="small-note formula-jump">Jump to: {g.tools.map((t,n)=><>{n>0&&' · '}<a class="text-link" href={`#${t.slug}`}>{guideFor(t.slug).formulaHeading}</a></>)}</p><div class="formula-reference">{g.tools.map(t=><section class="explanation" id={t.slug}><span class="badge">{t.category}</span><h3>{guideFor(t.slug).formulaHeading}</h3><FormulaList formulas={guideFor(t.slug).formulas}/><p>{t.assumption}</p><div class="formula-card-links"><a class="text-link" href={`/experiments/${t.slug}/`}>{guideFor(t.slug).heading} ↗</a><a class="text-link" href={`/learn/${t.slug}/`}>Worked example: {guideFor(t.slug).lessonHeading} ↗</a></div></section>)}</div></section>{i===0&&<AdSlot type="rectangle"/>}{i===2&&<AdSlot type="rectangle"/>}</>)}<section id="more-formulas"><h2>More essential physics formulas</h2><p class="small-note">Standard relationships that appear alongside the simulations in most introductory courses.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th scope="col">Quantity</th><th scope="col">Formula</th><th scope="col">What the symbols mean</th></tr></thead><tbody>{essentials.map(([name,formula,note,id,slug])=><tr id={id}><td>{slug?<a class="text-link" href={`/experiments/${slug}/`}>{name}</a>:name}</td><td><code>{formula}</code></td><td>{note}</td></tr>)}</tbody></table></div></section></div><div class="related"><a href="/physics-symbols/">Physics symbols explained ↗</a><a href="/units/">Units & constants ↗</a><a href="/worksheets/">Print a practice sheet ↗</a></div></Layout>
