---
import '../styles/global.css';
import '../styles/studio.css';
import '../styles/physics.css';
import {learningApps,currentApp} from '../lib/learning-apps.mjs';
import AdSlot from '../components/AdSlot.astro';
const sisterApps=learningApps.filter(app=>app.id!==currentApp&&app.url);
const brand='The Physics Lab';
const {title='Free Online Physics Simulations & Virtual Lab',description='The Physics Lab is a free virtual physics lab with interactive simulations, calculators, explanations, and practice for motion, forces, waves, circuits, and optics.',section='Explore',schemaType='WebApplication',noindex=false,ads=true}=Astro.props;
const url=new URL(Astro.url.pathname,Astro.site);const home=new URL('/',Astro.site).href;const isHome=Astro.url.pathname==='/';
// Append the brand only while the whole title stays within typical search-snippet width.
const fullTitle=title.includes(brand)||title.length+brand.length+3>65?title:`${title} | ${brand}`;
const nav=[['Explore','/'],['Experiments','/experiments/'],['Learn','/learn/'],['Practice','/practice/'],['Formulas','/formulas/']];
const org={'@type':'Organization',name:brand,url:home,logo:new URL('/favicon.svg',Astro.site).href};
const schema=schemaType==='Article'?{'@context':'https://schema.org','@type':'Article',headline:title,description,url:url.href,mainEntityOfPage:url.href,author:org,publisher:org,isAccessibleForFree:true,inLanguage:'en'}:schemaType==='CollectionPage'?{'@context':'https://schema.org','@type':'CollectionPage',name:title,description,url:url.href,isAccessibleForFree:true,inLanguage:'en',publisher:org}:{'@context':'https://schema.org','@type':'WebApplication',name:isHome?brand:title,url:url.href,description,applicationCategory:'EducationalApplication',operatingSystem:'Any',browserRequirements:'Requires JavaScript',isAccessibleForFree:true,inLanguage:'en',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},publisher:org};
const site=[{'@context':'https://schema.org','@type':'WebSite',name:brand,alternateName:['Physics Lab','thephysicslab.org'],url:home,description,inLanguage:'en',publisher:org},{'@context':'https://schema.org',...org,description:'Free interactive physics simulations, lessons, and practice for students and teachers.'}];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{fullTitle}</title><meta name="description" content={description}/>{noindex?<meta name="robots" content="noindex,follow"/>:<link rel="canonical" href={url}/>}<meta name="theme-color" content="#fffaf1"/><meta property="og:site_name" content={brand}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={schemaType==='Article'?'article':'website'}/><meta property="og:url" content={url}/><meta property="og:locale" content="en_US"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{!noindex&&<script type="application/ld+json" set:html={JSON.stringify(schema)}/>}{isHome&&<script type="application/ld+json" set:html={JSON.stringify(site)}/>}
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2ZHXFW2460"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-2ZHXFW2460');
</script>
</head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a href="/" class="brand" aria-label="The Physics Lab home"><img src="/favicon.svg" alt="" width="44" height="44"/><span>physics<span class="brand-light">lab</span><small>A LITTLE WONDER. A LOT OF WHY.</small></span></a><nav aria-label="Main navigation">{nav.map(([label,href])=><a href={href} class:list={{active:label===section}} aria-current={label===section?'page':undefined}>{label}</a>)}</nav><a href="/worksheets/" class="header-learn">Worksheets ↗</a></header><main id="main"><slot/></main>{ads&&<AdSlot type="leaderboard"/>}<footer class="site-footer"><a class="footer-brand" href="/">physics<span class="brand-light">lab</span></a><p>Big ideas. Small experiments.</p><div><a href="/formulas/">Physics formula sheet</a><a href="/physics-symbols/">Physics symbols</a><a href="/units/">Units & constants</a><a href="/about/">About the lab</a><a href="/#learning-apps">Explore our learning apps</a><a href="/worksheets/">Print & practice</a><a href="/privacy/">Privacy</a></div><nav class="footer-apps" aria-label="More free learning apps"><strong>More free learning apps</strong>{sisterApps.map(app=><a href={app.url+'/'}>{app.name}</a>)}</nav><span>Free to explore. No account needed. Educational models with their assumptions explained.</span></footer></body></html>
