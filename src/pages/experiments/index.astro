---
import Layout from '../../layouts/Layout.astro';import Cards from '../../components/Cards.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import {experiments,categories} from '../../lib/experiments.mjs';
---
<Layout title="Online Physics Simulations: 12 Free Interactive Experiments" description="Browse 12 free online physics simulations with calculators: projectile motion, pendulums, springs, waves, Ohm’s law, circuits, refraction and lenses." section="Experiments" schemaType="CollectionPage"><Breadcrumbs items={[['Home','/'],['Experiments']]}/><div class="intro"><div><div class="eyebrow">One question. Twelve ways in.</div><h1>Online physics simulations & experiments</h1><p>Explore motion, energy, waves, circuits, and light in a free virtual physics lab. Change something, notice what follows, and see the formula behind every result.</p></div></div><experiment-catalog><div class="catalog-controls"><input data-search type="search" placeholder="Search motion, voltage, lenses…" aria-label="Search experiments"/><div class="pills">{categories.map((c,i)=><button data-category={c} class:list={['pill',{selected:i===0}]} aria-pressed={i===0}>{c}</button>)}</div></div><p class="catalog-count" data-count aria-live="polite">12 experiments</p><Cards tools={experiments}/><p class="catalog-empty" data-empty hidden>No experiments match. Try another word or choose All.</p></experiment-catalog><div class="related"><a href="/learn/">Lessons with worked examples ↗</a><a href="/formulas/">Physics formula sheet ↗</a><a href="/practice/">Physics practice problems ↗</a><a href="/worksheets/">Printable worksheets ↗</a></div></Layout>
<script>
class Catalog extends HTMLElement{connectedCallback(){let category='All';const input=this.querySelector('[data-search]') as HTMLInputElement;const cards=Array.from(this.querySelectorAll<HTMLElement>('[data-tool]'));const update=()=>{let n=0;cards.forEach(c=>{c.hidden=!(c.dataset.text!.includes(input.value.trim().toLowerCase())&&(category==='All'||c.dataset.topic===category));if(!c.hidden)n++});this.querySelector('[data-count]')!.textContent=`${n} ${n===1?'experiment':'experiments'}`;(this.querySelector('[data-empty]') as HTMLElement).hidden=n!==0;};input.oninput=update;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.onclick=()=>{category=b.dataset.category!;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});update();});}}
customElements.define('experiment-catalog',Catalog);
</script>
