---
import Layout from '../layouts/Layout.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import AdSlot from '../components/AdSlot.astro';
// Each row: symbol, meaning, SI unit, a formula where the symbol appears, and an optional experiment slug that uses it.
const sections=[
['motion','Motion',[['x, s, d','Position, displacement, or distance','m','x = v₀t + ½at²','motion-graphs'],['Δx','Displacement (change in position)','m','Δx = x − x₀','motion-graphs'],['t','Time','s','v = v₀ + at','motion-graphs'],['v','Velocity (speed with a direction)','m/s','v = Δx/Δt','motion-graphs'],['v₀ or u','Initial velocity','m/s','v = v₀ + at','motion-graphs'],['a','Acceleration','m/s²','a = Δv/Δt','motion-graphs'],['g','Gravitational acceleration (9.81 m/s² on Earth)','m/s² or N/kg','W = mg','projectile-motion'],['θ','Angle, such as a launch angle or ramp angle','° or rad','R = v₀² sin 2θ / g','projectile-motion'],['R','Range of a projectile','m','R = v₀² sin 2θ / g','projectile-motion'],['h, H','Height; H is often maximum height','m','H = v₀² sin²θ / (2g)','projectile-motion']]],
['forces','Forces',[['F','Force','N','F = ma','force-and-friction'],['Fnet, ΣF','Net (resultant) force: the sum of all forces','N','Fnet = ma','force-and-friction'],['m','Mass','kg','F = ma','force-and-friction'],['W, Fg','Weight, the gravitational force on a mass','N','W = mg','buoyancy'],['N, Fₙ','Normal force from a surface','N','N = mg on level ground','force-and-friction'],['f','Friction force','N','f = μN','force-and-friction'],['fₛ','Static friction force (object not sliding)','N','fₛ ≤ μₛN','force-and-friction'],['fₖ','Kinetic friction force (object sliding)','N','fₖ = μₖN','force-and-friction'],['μ, μₛ, μₖ','Coefficient of friction: general, static, kinetic','none','f = μmg on level ground','force-and-friction'],['T, Fₜ','Tension in a rope, string, or cable','N','T = mg for a hanging mass at rest',''],['k','Spring constant (stiffness)','N/m','F = −kx','spring-oscillator'],['Fᵦ','Buoyant force','N','Fᵦ = ρfluid g Vsubmerged','buoyancy'],['ρ','Density','kg/m³','ρ = m/V','buoyancy'],['V','Volume','m³','Fᵦ = ρgV','buoyancy'],['p','Momentum','kg·m/s','p = mv',''],['G','Gravitational constant, 6.674 × 10⁻¹¹','N·m²/kg²','F = Gm₁m₂/r²',''],['r','Radius or separation distance','m','F = mv²/r','']]],
['energy','Energy, work & power',[['E','Energy','J','E = PE + KE','energy-conservation'],['KE, Eₖ','Kinetic energy','J','KE = ½mv²','energy-conservation'],['PE, Eₚ, U','Potential energy','J','PE = mgh','energy-conservation'],['W','Work done by a force','J','W = Fd cos θ',''],['P','Power: energy transferred per second','W','P = W/t = Fv',''],['η','Efficiency','% or none','η = useful output ÷ input','']]],
['waves','Oscillations & waves',[['T','Period: time for one complete cycle','s','T = 2π√(L/g)','pendulum'],['f','Frequency: cycles per second','Hz','f = 1/T','wave-explorer'],['ω','Angular frequency','rad/s','ω = √(k/m)','spring-oscillator'],['λ','Wavelength: distance between neighbouring crests','m','v = fλ','wave-explorer'],['A','Amplitude: largest displacement from equilibrium','m','E = ½kA²','spring-oscillator'],['L','Length of a pendulum','m','T = 2π√(L/g)','pendulum']]],
['electricity','Electricity',[['V, ΔV','Voltage (potential difference)','V (volt)','V = IR','ohms-law'],['I','Electric current','A (ampere)','I = V/R','ohms-law'],['R','Resistance','Ω (ohm)','R = R₁ + R₂ in series','resistor-circuits'],['Ω','The ohm, the unit of resistance','—','1 Ω = 1 V/A','ohms-law'],['Q','Electric charge','C (coulomb)','Q = It',''],['P','Electrical power','W (watt)','P = VI = I²R = V²/R','ohms-law']]],
['optics','Optics',[['n','Refractive index','none','n = c/v','refraction'],['c','Speed of light in a vacuum, 3.00 × 10⁸','m/s','n = c/v','refraction'],['θ₁, θ₂','Angles of incidence and refraction, from the normal','°','n₁ sin θ₁ = n₂ sin θ₂','refraction'],['θc','Critical angle','°','θc = arcsin(n₂/n₁)','refraction'],['f','Focal length of a lens','m or cm','1/f = 1/dₒ + 1/dᵢ','thin-lens'],['dₒ, dᵢ','Object distance and image distance','m or cm','1/f = 1/dₒ + 1/dᵢ','thin-lens'],['M','Magnification','none','M = −dᵢ/dₒ','thin-lens']]]];
const reused=[['T','Period of an oscillation, or tension in a rope.'],['P','Power in watts, or pressure in pascals (often lower-case p).'],['p','Momentum, or pressure.'],['W','Weight (a force, in N), work (energy, in J), or the unit watt.'],['V','Voltage in volts, or volume in m³.'],['f','Frequency in Hz, friction force in N, or a lens’s focal length.'],['R','Resistance in ohms, the range of a projectile, or a radius.'],['Ft','Tension force Fₜ, or force × time, which is impulse (N·s).']];
---
<Layout title="Physics Symbols and Their Meanings (with Units)" description="What do F, fₛ, μ, Fₜ, λ, ρ and Ω mean in physics? A clear table of common physics symbols with their meaning, SI unit, and a formula where each one appears." section="Formulas" schemaType="Article"><article class="article"><Breadcrumbs items={[['Home','/'],['Formula sheet','/formulas/'],['Physics symbols']]}/><div class="eyebrow">Small letters. Big meanings.</div><h1>Physics symbols and what they mean</h1><p class="lesson-lead">Physics formulas are written in symbols: F for force, m for mass, λ for wavelength, μ for the coefficient of friction. The tables below list the symbols used in introductory physics with their meaning, SI unit, and a formula where you will meet each one. Some letters mean different things in different topics, so always check the context.</p><nav class="related" aria-label="Symbol topics">{sections.map(([id,name])=><a href={`#${id}`}>{name}</a>)}<a href="#same-letter">Same letter, different meaning</a></nav>{sections.map(([id,name,rows],i)=><><section class="symbol-section" id={id}><h2>{name} symbols</h2><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th>Symbol</th><th>Meaning</th><th>SI unit</th><th>Example formula</th></tr></thead><tbody>{rows.map(([symbol,meaning,unit,formula,slug])=><tr><td><code>{symbol}</code></td><td>{meaning}</td><td>{unit}</td><td>{slug?<a class="text-link" href={`/experiments/${slug}/`}>{formula}</a>:formula}</td></tr>)}</tbody></table></div></section>{i===0&&<AdSlot type="rectangle"/>}</>)}<section class="symbol-section" id="same-letter"><h2>Same letter, different meaning</h2><p>A handful of letters do double duty. The units usually tell you which quantity is meant.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th>Symbol</th><th>Possible meanings</th></tr></thead><tbody>{reused.map(([symbol,meaning])=><tr><td><code>{symbol}</code></td><td>{meaning}</td></tr>)}</tbody></table></div></section><h2>Subscripts and Greek letters</h2><p>A subscript zero, as in v₀ or x₀, marks the starting value. Δ (delta) means “change in”, so Δx is final position minus initial position. Σ (sigma) means “sum of”, so ΣF is the net force. Greek letters often name angles (θ), densities (ρ), friction coefficients (μ), wavelengths (λ), and angular frequencies (ω).</p><AdSlot type="native"/><div class="related"><a href="/formulas/">Physics formula sheet ↗</a><a href="/units/">Units & constants ↗</a><a href="/experiments/">Try the simulations ↗</a></div></article></Layout>
