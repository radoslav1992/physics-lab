---
import LearningApps from '../components/LearningApps.astro';
import Layout from '../layouts/Layout.astro';import Experiment from '../components/Experiment.astro';import Cards from '../components/Cards.astro';import Faq from '../components/Faq.astro';import {experiments} from '../lib/experiments.mjs';
const questions=[{question:'What is The Physics Lab?',answer:'The Physics Lab is a free virtual physics lab that runs in your browser. Twelve interactive simulations cover projectile motion, motion graphs, friction, energy, pendulums, springs, waves, Ohm’s law, series and parallel circuits, buoyancy, refraction, and lenses. Change an input to see the diagram, measurements, and worked calculation respond.',href:'/experiments/',label:'Browse all simulations'},{question:'Is The Physics Lab free?',answer:'Yes. Simulations, lessons, practice problems, worksheets, and diagram downloads are free without an account. All calculations happen in your browser.'},{question:'Can I run physics lab experiments online here?',answer:'Yes. Each simulation works like a small online lab: set the starting conditions, press Play, record the measurements, and compare them with the formula. Shareable links keep your settings, so a class can repeat the same experiment.',href:'/experiments/pendulum/',label:'Try the pendulum lab'},{question:'Are the simulations physically realistic?',answer:'They use standard introductory physics models. Every experiment explains its assumptions, such as no air resistance, no friction, a small-angle approximation, or ideal circuit components. Use them to understand relationships rather than as engineering design tools.'},{question:'Can I use this in a lesson?',answer:'Yes. Share a link containing your experiment settings, download an SVG diagram, or print a worksheet with an optional answer key. The practice studio also gives an explanation after every answer.',href:'/worksheets/',label:'Create a worksheet'},{question:'Where should I begin?',answer:'Try changing the launch angle in the projectile experiment. Predict which angle sends the ball farthest, then test it. Follow the linked lesson when you want to understand why.',href:'/experiments/projectile-motion/',label:'Explore projectile motion'}];
const paths=[['Motion & forces','Launch, accelerate, push, and float.',[['/experiments/projectile-motion/','Projectile motion simulator'],['/experiments/motion-graphs/','Position, velocity & acceleration graphs'],['/experiments/force-and-friction/','Friction force calculator (f = μN)'],['/experiments/buoyancy/','Buoyancy & buoyant force calculator']]],['Energy & oscillations','Trade height for speed and find the rhythm.',[['/experiments/energy-conservation/','Conservation of energy on a ramp'],['/experiments/pendulum/','Pendulum period calculator'],['/experiments/spring-oscillator/','Spring oscillator & Hooke’s law'],['/experiments/wave-explorer/','Wave speed simulator (v = fλ)']]],['Electricity & light','Follow current through wires and light through glass.',[['/experiments/ohms-law/','Ohm’s law & power calculator'],['/experiments/resistor-circuits/','Resistors in series & parallel'],['/experiments/refraction/','Total internal reflection simulation'],['/experiments/thin-lens/','Converging lens simulator']]]];
---
<Layout title="The Physics Lab: Free Online Physics Simulations & Virtual Lab" description="The Physics Lab is a free virtual physics lab: 12 online simulations with calculators for projectile motion, circuits, pendulums, waves and optics. No sign-up."><section class="home-stage"><div class="home-intro"><div class="eyebrow">Free online physics simulations</div><h1>The <em>Physics</em> Lab. <span class="h1-tagline">A virtual physics lab for curious minds.</span></h1><p><strong class="playful-lead">A little wonder. A big “why?”</strong>Launch a ball. Bend a ray. Catch a wave. Twelve interactive simulations with live calculators make the invisible click.</p><a href="/experiments/" class="primary-link">Find your next experiment ↗</a><div class="home-note"><span class="note-mark" aria-hidden="true">↳</span><span>Start right here.<br/><strong>Which angle goes the farthest?</strong></span></div><span class="free-note">Free tools · No account · Just curiosity</span></div><div class="home-experiment"><Experiment tool={experiments[0]} compact/><a href="/experiments/projectile-motion/" class="experiment-link">Open the full projectile motion simulator <span>↗</span></a></div></section><div class="stat-strip"><span><strong>12</strong>interactive simulations</span><span><strong>5</strong>fields of physics</span><span><strong>12</strong>lessons with worked examples</span><span><strong>100</strong>practice questions</span></div><div class="section-heading"><div><div class="eyebrow">Follow a question</div><h2>Physics Simulations & Visual Calculators</h2><p>What happens if…? There’s only one way to find out.</p></div><a class="text-link" href="/experiments/">Explore all experiments ↗</a></div><Cards tools={[experiments[1],experiments[3],experiments[4],experiments[6],experiments[8],experiments[9]]}/><div class="section-heading"><div><div class="eyebrow">Jump straight in</div><h2>Popular physics calculators</h2><p>Every calculator shows its formula, its assumptions, and each step of the working.</p></div><a class="text-link" href="/formulas/">Physics formula sheet ↗</a></div><div class="path-grid">{paths.map(([heading,text,links])=><section class="path-card"><h3>{heading}</h3><p>{text}</p><ol>{links.map(([href,label])=><li><a href={href}>{label}</a></li>)}</ol></section>)}</div><div class="learning-strip"><div><span class="strip-label">PREDICT. PLAY. UNDERSTAND.</span><h2>Make your next “aha” stick.</h2><p>Eight questions. Clear explanations. All the time you need.</p></div><a href="/practice/">Try physics practice problems ↗</a></div><LearningApps/><Faq items={questions} title="The Physics Lab: frequently asked questions" schema/></Layout>
