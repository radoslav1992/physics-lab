---
import Layout from '../../layouts/Layout.astro';import Experiment from '../../components/Experiment.astro';import Faq from '../../components/Faq.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import FormulaList from '../../components/FormulaList.astro';import AdSlot from '../../components/AdSlot.astro';import {experiments} from '../../lib/experiments.mjs';import {guideFor} from '../../lib/guides.mjs';
export function getStaticPaths(){return experiments.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;const guide=guideFor(tool.slug);const related=experiments.filter(t=>t.category===tool.category&&t.slug!==tool.slug);
---
<Layout title={guide.seoTitle} description={guide.seoDescription} section="Experiments"><Breadcrumbs items={[['Home','/'],['Experiments','/experiments/'],[tool.title]]}/><div class="intro"><div><div class="eyebrow">{tool.tag}</div><h1>{guide.heading}</h1><p>{guide.answer}</p></div></div><Experiment tool={tool}/><AdSlot type="rectangle"/><section class="explanation key-formulas" aria-labelledby="key-formulas"><span class="badge">{tool.category}</span><h2 id="key-formulas">Formulas used in this simulation</h2><FormulaList formulas={guide.formulas}/><a class="text-link" href={`/learn/${tool.slug}/`}>Formulas explained with a worked example ↗</a></section><AdSlot type="native"/><div class="related"><a href={`/learn/${tool.slug}/`}>{guide.lessonHeading} ↗</a>{related.map(t=><a href={`/experiments/${t.slug}/`}>{guideFor(t.slug).heading} ↗</a>)}<a href="/formulas/">Physics formula sheet ↗</a><a href="/practice/">Practice problems ↗</a></div><Faq title={`${tool.title}: common questions`} items={[...guide.faqs,...tool.faqs].map(([question,answer])=>({question,answer}))} schema/></Layout>
