---
import Layout from '../../../layouts/Layout.astro';import Breadcrumbs from '../../../components/Breadcrumbs.astro';import ActivityTable from '../../../components/ActivityTable.astro';import ClassroomShare from '../../../components/ClassroomShare.astro';import {experiments} from '../../../lib/experiments.mjs';import {activities,standards} from '../../../lib/activities.mjs';
export function getStaticPaths(){return activities.map(act=>({params:{slug:act.slug},props:{act,tool:experiments.find(t=>t.slug===act.slug)}}));}
const {act,tool}=Astro.props;const url=new URL(`/experiments/${tool.slug}/activity/`,Astro.site).href;
// Keep the title and description within typical search-snippet length.
const title=[`${act.title}: Free Student Activity`,`${act.title} (Free Printable)`,act.title].find(t=>t.length<=60)??act.title;
const description=[`Free printable ${act.title.toLowerCase()} for ${act.grade.toLowerCase()}, about ${act.minutes} minutes with the interactive simulation. No sign-up; answer key for teachers.`,`Free printable ${act.title.toLowerCase()} for ${act.grade.toLowerCase()}, about ${act.minutes} minutes with the interactive simulation. Answer key for teachers.`].find(d=>d.length<=160)??`Free printable ${act.title.toLowerCase()} for ${act.grade.toLowerCase()}, with a teacher answer key.`;
const resource={'@context':'https://schema.org','@type':'LearningResource',name:act.title,description:act.goal,url,learningResourceType:'Worksheet',educationalLevel:act.grade,timeRequired:`PT${act.minutes}M`,isAccessibleForFree:true,inLanguage:'en',...(act.standards.length?{educationalAlignment:act.standards.map(code=>({'@type':'AlignmentObject',alignmentType:'educationalSubject',educationalFramework:'Next Generation Science Standards',targetName:code}))}:{})};
---
<Layout title={title} description={description} section="Experiments" schemaType="Article"><article class="worksheet"><Breadcrumbs items={[['Home','/'],['Experiments','/experiments/'],[tool.title,`/experiments/${tool.slug}/`],['Classroom activity']]}/><header class="worksheet-head"><div><span class="eyebrow">Student activity · {act.grade} · about {act.minutes} minutes</span><h1>{act.title}</h1></div><div class="name-lines" aria-hidden="true"><span>Name</span><span>Class</span><span>Date</span></div></header><p class="worksheet-goal"><strong>Goal:</strong> {act.goal}</p><p class="worksheet-meta">Open the simulation at <strong>thephysicslab.org/experiments/{tool.slug}/</strong>{act.standards.length>0&&<span> · Connects to NGSS {act.standards.join(', ')}</span>}</p><div class="page-actions no-print"><button class="primary-link print-button" type="button" data-print>Print worksheet</button><a class="secondary" href={`/experiments/${tool.slug}/`}>Open the simulation ↗</a><ClassroomShare url={url}/></div><h2>What to do</h2><ol class="steps">{act.steps.map(step=><li>{step}</li>)}</ol><h2>Record your results</h2><ActivityTable act={act}/><h2>Questions</h2><ol class="questions">{act.questions.map(q=><li><p>{q.q}</p><div class="write-lines" aria-hidden="true">{Array.from({length:q.lines},()=><span/>)}</div></li>)}</ol><p class="worksheet-foot">Free from The Physics Lab · thephysicslab.org{act.standards.length>0&&<span class="no-print"> · {act.standards.map(code=>`${code}: ${standards[code]}`).join(' ')}</span>}</p></article><script type="application/ld+json" set:html={JSON.stringify(resource)}/></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click',()=>print());</script>
