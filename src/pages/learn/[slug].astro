---
import RelatedLearning from '../../components/RelatedLearning.astro';
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import FormulaList from '../../components/FormulaList.astro';import AdSlot from '../../components/AdSlot.astro';import {experiments,defaults} from '../../lib/experiments.mjs';import {guideFor} from '../../lib/guides.mjs';import {calculate} from '../../lib/physics.mjs';import {diagram} from '../../lib/diagrams.mjs';
export function getStaticPaths(){return experiments.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;const guide=guideFor(tool.slug);const result=calculate(tool.slug,defaults(tool),.25,tool.modes?.[0][0]??'series');
---
<Layout title={guide.lessonTitle} description={guide.lessonDescription} section="Learn" schemaType="Article"><article class="article"><Breadcrumbs items={[['Home','/'],['Lessons','/learn/'],[tool.title]]}/><div class="eyebrow">{tool.tag}</div><h1>{guide.lessonHeading}.</h1><p class="lesson-lead">{tool.lesson}</p><div class="lesson-diagram"><svg viewBox="0 0 680 360" role="img" aria-label={`${tool.title} example diagram`} set:html={diagram(tool.slug,result.model)}/></div><h2>The relationship to remember</h2><div class="formula">{tool.formula}</div><h2>Key formulas</h2><FormulaList formulas={guide.formulas}/><h2>Worked example</h2><section class="worked-example" aria-label="Worked example"><p><strong>Problem.</strong> {guide.worked.problem}</p><ol>{guide.worked.steps.map(s=><li>{s}</li>)}</ol><p class="worked-answer"><strong>Answer.</strong> {guide.worked.answer}</p></section><AdSlot type="rectangle"/><h3>A quick check</h3><p>{tool.example}</p><h3>Inside the default experiment</h3><ol>{result.steps.map(s=><li>{s}</li>)}</ol><h2>When this model applies</h2><p>{tool.assumption}</p><aside class="challenge"><span class="badge">A COMMON MIX-UP</span><p>{tool.pitfall}</p></aside><h2>Make a prediction. Then test it.</h2><p>{tool.challenge}</p><a class="primary-link" href={`/experiments/${tool.slug}/`}>Try it: {guide.heading} ↗</a><AdSlot type="native"/><Faq items={tool.faqs.map(([question,answer])=>({question,answer}))}/><div class="related"><a href="/formulas/">Physics formula sheet ↗</a><a href="/physics-symbols/">What the symbols mean ↗</a><a href="/practice/">Practice problems ↗</a></div><RelatedLearning topic={tool.slug}/></article></Layout>
