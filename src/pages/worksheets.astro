---
import Layout from '../layouts/Layout.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import {experiments,countWord} from '../lib/experiments.mjs';import {activities} from '../lib/activities.mjs';
// One printable activity per simulation, listed under the worksheet builder so each topic's worksheet can be found here.
const sheets=activities.map(act=>({act,tool:experiments.find(t=>t.slug===act.slug)}));
---
<Layout title="Free Printable Physics Worksheets with Answer Keys" section="Practice" description="Free printable physics worksheets with answer keys: build an 8-, 12- or 20-question sheet by topic, or print a one-page activity on buoyancy or circuits."><Breadcrumbs items={[['Home','/'],['Worksheets']]}/><div class="intro"><div><div class="eyebrow">Take the learning with you</div><h1>Printable physics worksheets</h1><p>Choose a topic, generate a fresh set of physics questions, and print or save it as a PDF with or without the answer key. Every sheet is free and different. For a worksheet on one topic, such as buoyancy, projectile motion or circuits, see the <a class="text-link" href="#simulation-worksheets">worksheets for each simulation</a>.</p></div></div><worksheet-lab><div class="worksheet-controls"><label class="field">Topic<select data-topic><option value="mixed">Mixed topics</option><option value="motion">Motion</option><option value="energy">Forces & energy</option><option value="waves">Waves</option><option value="electricity">Electricity</option><option value="optics">Optics</option></select></label><label class="field">Questions<select data-count><option>8</option><option>12</option><option>20</option></select></label><button class="secondary" data-generate>New question set</button><button class="primary" data-print>Print / save as PDF</button><label class="check-row"><input type="checkbox" data-key checked/> Include answer key</label></div><div class="worksheet-paper" data-paper></div></worksheet-lab><noscript>Enable JavaScript to generate a worksheet. All lessons are available in the formula reference.</noscript><section class="no-print"><div class="section-heading"><div><h2 id="simulation-worksheets">Physics worksheets for each simulation</h2><p>{countWord} one-page student activities, each built around one simulation, with steps, a results table and questions. Teachers can open the answer keys from the <a class="text-link" href="/teachers/">teacher page</a>.</p></div></div><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th scope="col">Worksheet</th><th scope="col">Topic</th><th scope="col">Grades</th><th scope="col">Time</th></tr></thead><tbody>{sheets.map(({act,tool})=><tr><td><a class="text-link" href={`/experiments/${tool.slug}/activity/`}>{act.title}</a></td><td>{tool.category}</td><td>{act.grade.replace('Grades ','')}</td><td>{act.minutes} min</td></tr>)}</tbody></table></div><div class="related"><a href="/practice/">Physics practice problems with answers ↗</a><a href="/experiments/">Physics simulations ↗</a><a href="/formulas/">Physics formulas sheet ↗</a></div></section></Layout>
<script>
import {makeRound} from '../lib/practice.mjs';
class WorksheetLab extends HTMLElement{connectedCallback(){const topic=this.querySelector('[data-topic]') as HTMLSelectElement,count=this.querySelector('[data-count]') as HTMLSelectElement,key=this.querySelector('[data-key]') as HTMLInputElement;const generate=()=>{const round=makeRound(topic.value,Number(count.value));this.querySelector('[data-paper]')!.innerHTML=`<h2>The Physics Lab · ${topic.options[topic.selectedIndex].text}</h2><p class="small-note">${round.length} questions · Choose one answer for each. Show your working in the space provided.</p><p class="worksheet-print-name">Name: ____________________ &nbsp; Date: ______________</p><ol class="worksheet-questions">${round.map(q=>`<li>${q.q}<div class="worksheet-options">${q.choices.map((c:any,i:number)=>`${'ABCD'[i]}. ${c.text}`).join('<br/>')}</div></li>`).join('')}</ol><section class="worksheet-answers" ${key.checked?'':'hidden'}><h2>Answer key & explanations</h2><ol>${round.map(q=>`<li><strong>${'ABCD'[q.choices.findIndex((c:any)=>c.correct)]}. ${q.choices.find((c:any)=>c.correct).text}</strong><br/>${q.why}</li>`).join('')}</ol></section>`};topic.onchange=generate;count.onchange=generate;key.onchange=()=>{(this.querySelector('.worksheet-answers') as HTMLElement).hidden=!key.checked};(this.querySelector('[data-generate]') as HTMLButtonElement).onclick=generate;(this.querySelector('[data-print]') as HTMLButtonElement).onclick=()=>window.print();generate();}}
customElements.define('worksheet-lab',WorksheetLab);
</script>
