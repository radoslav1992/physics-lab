---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Printable Physics Worksheet Generator" section="Practice" description="Build a printable physics worksheet with 8, 12, or 20 questions and an optional answer key. Choose motion, energy, waves, electricity, optics, or a mixed set."><div class="intro"><div><div class="eyebrow">Take the learning with you</div><h1>Your next practice sheet.</h1><p>Choose a topic, generate a fresh set, and print with or without the answers.</p></div></div><worksheet-lab><div class="worksheet-controls"><label class="field">Topic<select data-topic><option value="mixed">Mixed topics</option><option value="motion">Motion</option><option value="energy">Forces & energy</option><option value="waves">Waves</option><option value="electricity">Electricity</option><option value="optics">Optics</option></select></label><label class="field">Questions<select data-count><option>8</option><option>12</option><option>20</option></select></label><button class="secondary" data-generate>New question set</button><button class="primary" data-print>Print / save as PDF</button><label class="check-row"><input type="checkbox" data-key checked/> Include answer key</label></div><div class="worksheet-paper" data-paper></div></worksheet-lab><noscript>Enable JavaScript to generate a worksheet. All lessons are available in the formula reference.</noscript></Layout>
<script>
import {makeRound} from '../lib/practice.mjs';
class WorksheetLab extends HTMLElement{connectedCallback(){const topic=this.querySelector('[data-topic]') as HTMLSelectElement,count=this.querySelector('[data-count]') as HTMLSelectElement,key=this.querySelector('[data-key]') as HTMLInputElement;const generate=()=>{const round=makeRound(topic.value,Number(count.value));this.querySelector('[data-paper]')!.innerHTML=`<h2>Physics Lab · ${topic.options[topic.selectedIndex].text}</h2><p class="small-note">${round.length} questions · Choose one answer for each. Show your working in the space provided.</p><p class="worksheet-print-name">Name: ____________________ &nbsp; Date: ______________</p><ol class="worksheet-questions">${round.map(q=>`<li>${q.q}<div class="worksheet-options">${q.choices.map((c:any,i:number)=>`${'ABCD'[i]}. ${c.text}`).join('<br/>')}</div></li>`).join('')}</ol><section class="worksheet-answers" ${key.checked?'':'hidden'}><h2>Answer key & explanations</h2><ol>${round.map(q=>`<li><strong>${'ABCD'[q.choices.findIndex((c:any)=>c.correct)]}. ${q.choices.find((c:any)=>c.correct).text}</strong><br/>${q.why}</li>`).join('')}</ol></section>`};topic.onchange=generate;count.onchange=generate;key.onchange=()=>{(this.querySelector('.worksheet-answers') as HTMLElement).hidden=!key.checked};(this.querySelector('[data-generate]') as HTMLButtonElement).onclick=generate;(this.querySelector('[data-print]') as HTMLButtonElement).onclick=()=>window.print();generate();}}
customElements.define('worksheet-lab',WorksheetLab);
</script>
